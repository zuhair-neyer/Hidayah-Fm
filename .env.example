# Optional local preview settings: set these environment variables before starting.
# The static preview does not read .env; use PowerShell $env:PORT='3000'.
PORT=3000
HOST=127.0.0.1

# The browser uses public/js/firebase-config.js, which contains public web config.
# No service-account key or session-signing secret belongs in public/.

# These settings are only for explicit legacy Node maintenance tools, which
# continue reading .env through server/config.js after npm ci:
# DATA_DIR=C:/your/private/legacy-catalogue-directory
# FIREBASE_API_KEY=your-public-web-api-key
# FIREBASE_PROJECT_ID=hidayah-fm

{"surah_id":112,"ayahs":[{"number":1,"global_number":6222,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","english":"Say, \"He is Allah, [who is] One,"},{"number":2,"global_number":6223,"arabic":"ٱللَّهُ ٱلصَّمَدُ","english":"Allah, the Eternal Refuge."},{"number":3,"global_number":6224,"arabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","english":"He neither begets nor is born,"},{"number":4,"global_number":6225,"arabic":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","english":"Nor is there to Him any equivalent.\""}],"source":"AlQuran Cloud","arabic_edition":"quran-uthmani","translation":"Sahih International","translation_edition":"en.sahih"}

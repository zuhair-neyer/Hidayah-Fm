{"surah_id":101,"ayahs":[{"number":1,"global_number":6158,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","english":"The Striking Calamity -"},{"number":2,"global_number":6159,"arabic":"مَا ٱلْقَارِعَةُ","english":"What is the Striking Calamity?"},{"number":3,"global_number":6160,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","english":"And what can make you know what is the Striking Calamity?"},{"number":4,"global_number":6161,"arabic":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","english":"It is the Day when people will be like moths, dispersed,"},{"number":5,"global_number":6162,"arabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","english":"And the mountains will be like wool, fluffed up."},{"number":6,"global_number":6163,"arabic":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","english":"Then as for one whose scales are heavy [with good deeds],"},{"number":7,"global_number":6164,"arabic":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","english":"He will be in a pleasant life."},{"number":8,"global_number":6165,"arabic":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","english":"But as for one whose scales are light,"},{"number":9,"global_number":6166,"arabic":"فَأُمُّهُۥ هَاوِيَةٌۭ","english":"His refuge will be an abyss."},{"number":10,"global_number":6167,"arabic":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","english":"And what can make you know what that is?"},{"number":11,"global_number":6168,"arabic":"نَارٌ حَامِيَةٌۢ","english":"It is a Fire, intensely hot."}],"source":"AlQuran Cloud","arabic_edition":"quran-uthmani","translation":"Sahih International","translation_edition":"en.sahih"}

{"surah_id":96,"ayahs":[{"number":1,"global_number":6107,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","english":"Recite in the name of your Lord who created -"},{"number":2,"global_number":6108,"arabic":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","english":"Created man from a clinging substance."},{"number":3,"global_number":6109,"arabic":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","english":"Recite, and your Lord is the most Generous -"},{"number":4,"global_number":6110,"arabic":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","english":"Who taught by the pen -"},{"number":5,"global_number":6111,"arabic":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","english":"Taught man that which he knew not."},{"number":6,"global_number":6112,"arabic":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","english":"No! [But] indeed, man transgresses"},{"number":7,"global_number":6113,"arabic":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","english":"Because he sees himself self-sufficient."},{"number":8,"global_number":6114,"arabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","english":"Indeed, to your Lord is the return."},{"number":9,"global_number":6115,"arabic":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","english":"Have you seen the one who forbids"},{"number":10,"global_number":6116,"arabic":"عَبْدًا إِذَا صَلَّىٰٓ","english":"A servant when he prays?"},{"number":11,"global_number":6117,"arabic":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","english":"Have you seen if he is upon guidance"},{"number":12,"global_number":6118,"arabic":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","english":"Or enjoins righteousness?"},{"number":13,"global_number":6119,"arabic":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","english":"Have you seen if he denies and turns away -"},{"number":14,"global_number":6120,"arabic":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","english":"Does he not know that Allah sees?"},{"number":15,"global_number":6121,"arabic":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","english":"No! If he does not desist, We will surely drag him by the forelock -"},{"number":16,"global_number":6122,"arabic":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","english":"A lying, sinning forelock."},{"number":17,"global_number":6123,"arabic":"فَلْيَدْعُ نَادِيَهُۥ","english":"Then let him call his associates;"},{"number":18,"global_number":6124,"arabic":"سَنَدْعُ ٱلزَّبَانِيَةَ","english":"We will call the angels of Hell."},{"number":19,"global_number":6125,"arabic":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","english":"No! Do not obey him. But prostrate and draw near [to Allah]."}],"source":"AlQuran Cloud","arabic_edition":"quran-uthmani","translation":"Sahih International","translation_edition":"en.sahih"}

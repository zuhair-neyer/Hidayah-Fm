{"surah_id":114,"ayahs":[{"number":1,"global_number":6231,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","english":"Say, \"I seek refuge in the Lord of mankind,"},{"number":2,"global_number":6232,"arabic":"مَلِكِ ٱلنَّاسِ","english":"The Sovereign of mankind."},{"number":3,"global_number":6233,"arabic":"إِلَٰهِ ٱلنَّاسِ","english":"The God of mankind,"},{"number":4,"global_number":6234,"arabic":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","english":"From the evil of the retreating whisperer -"},{"number":5,"global_number":6235,"arabic":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","english":"Who whispers [evil] into the breasts of mankind -"},{"number":6,"global_number":6236,"arabic":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","english":"From among the jinn and mankind.\""}],"source":"AlQuran Cloud","arabic_edition":"quran-uthmani","translation":"Sahih International","translation_edition":"en.sahih"}

{"surah_id":102,"ayahs":[{"number":1,"global_number":6169,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","english":"Competition in [worldly] increase diverts you"},{"number":2,"global_number":6170,"arabic":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","english":"Until you visit the graveyards."},{"number":3,"global_number":6171,"arabic":"كَلَّا سَوْفَ تَعْلَمُونَ","english":"No! You are going to know."},{"number":4,"global_number":6172,"arabic":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","english":"Then no! You are going to know."},{"number":5,"global_number":6173,"arabic":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","english":"No! If you only knew with knowledge of certainty..."},{"number":6,"global_number":6174,"arabic":"لَتَرَوُنَّ ٱلْجَحِيمَ","english":"You will surely see the Hellfire."},{"number":7,"global_number":6175,"arabic":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","english":"Then you will surely see it with the eye of certainty."},{"number":8,"global_number":6176,"arabic":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","english":"Then you will surely be asked that Day about pleasure."}],"source":"AlQuran Cloud","arabic_edition":"quran-uthmani","translation":"Sahih International","translation_edition":"en.sahih"}

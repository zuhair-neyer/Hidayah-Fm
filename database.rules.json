{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (!data.child('auth_valid_after').exists() || auth.token.auth_time >= data.child('auth_valid_after').val())",
        ".write": "auth != null && auth.uid === $uid && (!data.child('auth_valid_after').exists() || auth.token.auth_time >= data.child('auth_valid_after').val())",
        ".validate": "newData.hasChildren(['profile']) && (!data.child('auth_valid_after').exists() || (newData.child('auth_valid_after').isNumber() && newData.child('auth_valid_after').val() >= data.child('auth_valid_after').val()))",
        "profile": {
          ".validate": "newData.hasChildren(['id','name','email','created_at'])",
          "id": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 254 && newData.val() === auth.token.email"
          },
          "created_at": {
            ".validate": "newData.isString() && newData.val().length <= 40 && (!data.exists() || newData.val() === data.val())"
          },
          "$other": {
            ".validate": false
          }
        },
        "auth_valid_after": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= auth.token.auth_time && (!data.exists() || newData.val() >= data.val())"
        },
        "settings": {
          ".validate": "newData.hasChildren(['method','reciter_id','translation'])",
          "city": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "country": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "method": {
            ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 4 || newData.val() === 5 || newData.val() === 7 || newData.val() === 8 || newData.val() === 9 || newData.val() === 10 || newData.val() === 11 || newData.val() === 12 || newData.val() === 13 || newData.val() === 14 || newData.val() === 15 || newData.val() === 16)"
          },
          "reciter_id": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 7"
          },
          "translation": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "playlists": {
          ".validate": "newData.hasChildren()",
          "$playlist": {
            ".validate": "newData.hasChildren(['id','name','color','created_at'])",
            "id": {
              ".validate": "newData.isString() && newData.val() === $playlist && newData.val().length <= 128"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "created_at": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "items": {
              ".validate": "newData.hasChildren()",
              "$entry": {
                ".validate": "newData.hasChildren(['item_type', 'item_id', 'id', 'position', 'added_at']) && ((newData.child('item_type').val() === 'surah' && newData.child('item_id').val() <= 114 && newData.child('reciter_id').isNumber()) || (newData.child('item_type').val() === 'track' && !newData.child('reciter_id').exists()))",
                "item_type": {
                  ".validate": "newData.val() === 'surah' || newData.val() === 'track'"
                },
                "item_id": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
                },
                "reciter_id": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 7"
                },
                "id": {
                  ".validate": "newData.isString() && newData.val() === $entry && newData.val().length <= 128"
                },
                "position": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000"
                },
                "added_at": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "likes": {
          ".validate": "newData.hasChildren()",
          "$key": {
            ".validate": "newData.hasChildren(['item_type', 'item_id', 'id', 'created_at']) && ((newData.child('item_type').val() === 'surah' && newData.child('item_id').val() <= 114 && newData.child('reciter_id').isNumber()) || (newData.child('item_type').val() === 'track' && !newData.child('reciter_id').exists()))",
            "item_type": {
              ".validate": "newData.val() === 'surah' || newData.val() === 'track'"
            },
            "item_id": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
            },
            "reciter_id": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 7"
            },
            "id": {
              ".validate": "newData.isString() && newData.val() === $key && newData.val().length <= 128"
            },
            "created_at": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "history": {
          ".validate": "newData.hasChildren()",
          "$key": {
            ".validate": "newData.hasChildren(['item_type', 'item_id', 'id', 'last_played', 'plays']) && ((newData.child('item_type').val() === 'surah' && newData.child('item_id').val() <= 114 && newData.child('reciter_id').isNumber()) || (newData.child('item_type').val() === 'track' && !newData.child('reciter_id').exists()))",
            "item_type": {
              ".validate": "newData.val() === 'surah' || newData.val() === 'track'"
            },
            "item_id": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
            },
            "reciter_id": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 7"
            },
            "id": {
              ".validate": "newData.isString() && newData.val() === $key && newData.val().length <= 128"
            },
            "last_played": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "plays": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
            },
            "days": {
              ".validate": "newData.hasChildren()",
              "$day": {
                ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.val() === true"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "progress": {
          ".validate": "newData.hasChildren()",
          "$key": {
            ".validate": "newData.hasChildren(['item_type', 'item_id', 'seconds', 'duration', 'completed', 'updated_at']) && ((newData.child('item_type').val() === 'surah' && newData.child('item_id').val() <= 114 && newData.child('reciter_id').isNumber()) || (newData.child('item_type').val() === 'track' && !newData.child('reciter_id').exists()))",
            "item_type": {
              ".validate": "newData.val() === 'surah' || newData.val() === 'track'"
            },
            "item_id": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
            },
            "reciter_id": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 7"
            },
            "seconds": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('duration').val() + 1"
            },
            "duration": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
            },
            "completed": {
              ".validate": "newData.isBoolean()"
            },
            "updated_at": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "bookmark": {
          ".validate": "newData.hasChildren(['surah','ayah','name'])",
          "surah": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 114"
          },
          "ayah": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 286"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "$other": {
            ".validate": false
          }
        },
        "playback": {
          ".validate": "newData.hasChildren(['item','time','repeat','shuffle','updated_at'])",
          "item": {
            ".validate": "newData.hasChildren(['type','id']) && ((newData.child('type').val() === 'surah' && newData.child('id').val() <= 114 && newData.child('reciter_id').isNumber()) || (newData.child('type').val() === 'track' && !newData.child('reciter_id').exists()))",
            "type": {
              ".validate": "newData.val() === 'surah' || newData.val() === 'track'"
            },
            "id": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
            },
            "reciter_id": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 7"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "title_ar": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "subtitle": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "track_type": {
              ".validate": "newData.val() === 'nasheed' || newData.val() === 'naat'"
            },
            "audio_url": {
              ".validate": "newData.isString() && newData.val().length <= 2048"
            },
            "link_url": {
              ".validate": "newData.isString() && newData.val().length <= 2048"
            },
            "cover_url": {
              ".validate": "newData.isString() && newData.val().length <= 2048"
            },
            "$other": {
              ".validate": false
            }
          },
          "queue": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9][0-9]?|[1-4][0-9]{2})$/) && newData.hasChildren(['type','id']) && ((newData.child('type').val() === 'surah' && newData.child('id').val() <= 114 && newData.child('reciter_id').isNumber()) || (newData.child('type').val() === 'track' && !newData.child('reciter_id').exists()))",
              "type": {
                ".validate": "newData.val() === 'surah' || newData.val() === 'track'"
              },
              "id": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
              },
              "reciter_id": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 7"
              },
              "title": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "title_ar": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "subtitle": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "track_type": {
                ".validate": "newData.val() === 'nasheed' || newData.val() === 'naat'"
              },
              "audio_url": {
                ".validate": "newData.isString() && newData.val().length <= 2048"
              },
              "link_url": {
                ".validate": "newData.isString() && newData.val().length <= 2048"
              },
              "cover_url": {
                ".validate": "newData.isString() && newData.val().length <= 2048"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "time": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          },
          "repeat": {
            ".validate": "newData.val() === 'off' || newData.val() === 'all' || newData.val() === 'one'"
          },
          "shuffle": {
            ".validate": "newData.isBoolean()"
          },
          "updated_at": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        },
        "legacy_imports": {
          ".validate": "newData.hasChildren()",
          "$import": {
            ".validate": "newData.hasChildren(['imported_at','playlists','likes','history','progress','skippedItems'])",
            "imported_at": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "playlists": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "likes": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "history": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "progress": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "skippedItems": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
